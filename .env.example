# github | local | azure
FUDA_SOURCE=github

# github: log in with a GitHub App (see CONTRIBUTING.md). With `make dev` browse http://localhost:5173.
FUDA_BASE_URL=http://localhost:5173
FUDA_COOKIE_SECRET=change-me-to-a-long-random-string
FUDA_GITHUB_CLIENT_ID=
FUDA_GITHUB_CLIENT_SECRET=

# FUDA_SOURCE=local
# FUDA_LOCAL_PATH=../../safesleep/platform
# FUDA_TITLE=safesleep

# FUDA_SOURCE=azure
# FUDA_AZURE_ORG=
# FUDA_AZURE_PROJECT=
# FUDA_AZURE_REPO=
# FUDA_AZURE_PAT=             # Code: Read
# FUDA_AZURE_BEARER=          # local alternative: az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv

FUDA_WATCH_MAIN=false
FUDA_SYNC_COOLDOWN=30s
FUDA_CACHE_DIR=.fuda-cache
