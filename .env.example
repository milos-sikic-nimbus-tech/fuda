# local | github | azure
FUDA_SOURCE=local
FUDA_LOCAL_PATH=../../safesleep/platform
FUDA_TITLE=safesleep

# Optional basic auth (off when the password is empty). /healthz and /api/webhooks/* stay open.
# Prefer your proxy's auth when it has one.
# FUDA_AUTH_USER=fuda
# FUDA_AUTH_PASSWORD=

# Optional webhook secret. GitHub: the webhook's Secret (checked via X-Hub-Signature-256).
# Azure: send it as the X-Fuda-Secret header. Empty = webhooks accepted unsigned.
# FUDA_WEBHOOK_SECRET=

# FUDA_SOURCE=github
# FUDA_GITHUB_REPO=owner/repo
# FUDA_GITHUB_TOKEN=          # fine-grained: Contents + Pull requests read

# FUDA_SOURCE=azure
# FUDA_AZURE_ORG=
# FUDA_AZURE_PROJECT=
# FUDA_AZURE_REPO=
# FUDA_AZURE_PAT=             # Code: Read
# FUDA_AZURE_BEARER=          # local alternative: az account get-access-token --resource 499b84ac-1321-427f-aa17-267ca6975798 --query accessToken -o tsv

FUDA_WATCH_MAIN=false
FUDA_ARCHIVE_AFTER_DAYS=15
FUDA_SYNC_INTERVAL=3m   # 5s is handy with the local source
FUDA_SYNC_COOLDOWN=30s
FUDA_CACHE_DIR=.fuda-cache
